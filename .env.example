# ============================================================
# SantexPro — Environment Variables Template
# Nusxa oling va nomini .env.local qilib haqiqiy kalitlarni kiriting
# ============================================================

# --------------------------------------------------------
# SUPABASE (Baza va Realtime)
# --------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --------------------------------------------------------
# CLOUDFLARE R2 (Rasmlar buluti va CDN)
# --------------------------------------------------------
VITE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
VITE_R2_ACCOUNT_ID="your-cloudflare-account-id"
VITE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
VITE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
VITE_R2_BUCKET_NAME="santexpro-images"

# --------------------------------------------------------
# TELEGRAM BOT (Sotuv cheklari bildirishnomasi)
# --------------------------------------------------------
# @BotFather orqali olingan bot tokeni
VITE_TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# Chek yuboriladigan guruh yoki kanal ID si (masalan: -100...)
VITE_TELEGRAM_CHAT_ID="your-telegram-chat-id"
